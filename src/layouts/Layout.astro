---
import "../styles/global.css";

const {
  title = "Hyundong Jin",
  description = "Personal academic website",
  cvPage = false,
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google-site-verification" content="HTz7-YgjMMkUrm_hQabn1rITOH9HV47PWvJbJI_cI7E" />
    <title>{title}</title>
  </head>

  <body class={cvPage ? "cv-page" : ""}>
    <header class="site-header no-print">
      <div class="container nav">
        <a class="brand" href="/">Hyundong Jin</a>
        <nav class="nav-links">
          <a href="/">Home</a>
          <a href="/cv">CV</a>
          <a href="/publications">Publications</a>
        </nav>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="footer no-print">
      <div class="container">
        © {new Date().getFullYear()} Hyundong Jin. Built with Astro and GitHub Pages.
      </div>
    </footer>
  </body>
</html>
